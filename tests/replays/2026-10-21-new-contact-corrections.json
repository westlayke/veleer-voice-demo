    { "tool": "show_contact_draft", "args": { "first": "Katharine", "last": "Zelnik", "email": "katherine@example.org" }, "expect": { "field": { "#f_last": "Zelnik" } } },
    { "said": "K as in kite, A T H A R I N E at example dot org." },
    { "tool": "show_contact_draft", "args": { "email": "katharine@example.org" }, "expect": { "field": { "#f_email": "katharine@example.org" } } },
